# Neo4j — FHIR graph
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Internal company OpenAI-compatible chat API
INTERNAL_LLM_BASE_URL=https://internal-api.example.com/v1
INTERNAL_LLM_API_KEY=
INTERNAL_LLM_MODEL=your-chat-model

# Internal company OpenAI-compatible embedding API
# May be the same base URL as the chat API.
INTERNAL_EMBEDDING_BASE_URL=https://internal-api.example.com/v1
INTERNAL_EMBEDDING_API_KEY=
INTERNAL_EMBEDDING_MODEL=your-embedding-model
INTERNAL_EMBEDDING_DIMS=768

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fhir_agent

# Mem0
MEM0_AGENT_ID=fhir-clinical-agent
MEM0_VECTOR_STORE_PROVIDER=pgvector
MEM0_COLLECTION_NAME=fhir_agent_memories

# Short-term conversational memory
SHORT_TERM_ENABLED=true
SHORT_TERM_MAX_TOKENS=12000
SHORT_TERM_RECENT_TOKENS=6000
SHORT_TERM_SUMMARY_MAX_TOKENS=2000
SHORT_TERM_COMPACTION_THRESHOLD=0.75
SHORT_TERM_CHARS_PER_TOKEN=4.0

# JWT authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application
DOMAIN_ID=healthcare
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Skin diagnostic workflow
# Leave model/base URL empty to reuse INTERNAL_LLM_* settings.
SKIN_VISION_BASE_URL=
SKIN_VISION_MODEL=
SKIN_REASONING_BASE_URL=
SKIN_REASONING_MODEL=
SKIN_EMBEDDING_BASE_URL=
SKIN_EMBEDDING_API_KEY=
SKIN_EMBEDDING_MODEL=
SKIN_LLM_MAX_TOKENS=4096
SKIN_KB_ENABLED=true
SKIN_QDRANT_URL=http://localhost:6333
SKIN_QDRANT_COLLECTION=disease_symptoms
SKIN_KB_MIN_SCORE=0.6
SKIN_SESSION_TTL_HOURS=24
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Upstream skin-diagnostic-system variable names.
# These are used by the vendored upstream pipeline/config modules.
VISION_MODEL_URL=http://172.16.12.230:8000
VISION_MODEL_DEFAULT=gemma-4-26B-A4B-it
VISION_MODEL_PREFER=gemma-4
VISION_MODEL_TIMEOUT=600
REASONING_MODEL_URL=http://172.16.12.230:8000
REASONING_MODEL_DEFAULT=gemma-4-26B-A4B-it
REASONING_MODEL_PREFER=gemma-4
REASONING_MODEL_TIMEOUT=1200
EMBEDDING_URL=http://172.16.12.230:8004
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT=120
QDRANT_MODE=server
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=disease_symptoms
